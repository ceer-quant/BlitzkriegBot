.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Runtime state + logs (trade ledger, soak, shadow, order DB). Machine-generated,
# may contain real trade history; kept on disk but not versioned.
data/
# ...but DO version committed evidence/repro data under docs (A/B runs, UI screenshots).
!docs/reports/data/
!docs/reports/data/**

# Model/transformers cache (large, reproducible)
.transformers-cache/

# Rust build output (workspace root)
target/
user_layer/strategies/target/

# Local agent/tooling session state (hook state, continue files)
.mimosa/

# Scratch files
*.tmp.mjs

# Coverage
coverage/

# Frontend apps - LOCAL ONLY, never push but NEVER DELETE
# Deploy via: cd apps/docs && vercel --prod --yes
apps/
.nyc_output/

# TypeScript cache
*.tsbuildinfo

# Local config
.vercel/

# =============================================================================
# Development/Internal - Not for production repo
# =============================================================================

# Frontend website (separate repo, not part of this workspace)
apps/

# Placeholder folders
vendor/

# Legacy local HFT dashboards (hand-authoured HTML/JS, local-only, never pushed).
