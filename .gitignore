# Dependencies
node_modules/

# Build output
dist/

# Environment
.env
.env.local
.env.*.local
# Pre-merge backup of a DIFFERENT project's .env (holds its own credentials)
.env.other-project-backup-*

# --- Secrets: never version (repo-governance hardening) ---------------------
# The ONLY env file that is ever committed is the template.
.env.*
!.env.example
