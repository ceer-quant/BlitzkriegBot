# BlitzkriegBot — environment surface (single source of truth)
#
# Copy to `.env` and fill in what you need. Nothing required in dry mode.
# Never commit a filled-in `.env`. chmod 600 after creating.
#
# Every key has a real reader; an empty key = disabled/default.

# ── Only switch you ever flip ────────────────────────────────────────────────
# DRY_RUN=true  simulate every order, never touch venue cash
# DRY_RUN=false live orders — wallet-funded account + operator approval required
DRY_RUN=true

# ── Panel credentials (required once, read from here) ──────────────────────────
# Generate: openssl rand -hex 16  /  openssl rand -base64 24
BLITZKRIEG_PANEL_USER=
BLITZKRIEG_PANEL_PASSWORD=

# ── Kernel (BK_*) — CLI flag > this env > compiled default ─────────────────────
# Nothing is required here; defaults are safe. Set only what you intend to change.

# Order budget: percentage of account cash equity per entry (0 = off)
# BK_SIZE_PCT=

# Daily-loss breaker: absolute USD (tighter of the two applies)
# BK_MAX_DAILY_LOSS=
# BK_MAX_DAILY_LOSS_PCT=   % of opening cash equity

# Per-order notional cap, % of cash equity (over-cap rejected, never truncated)
# BK_MAX_ORDER_NOTIONAL_PCT=

# BK_SETTLEMENT_FALLBACK_FLOOR_PCT is removed: unverifiable-expiry closes book
# at the raw last mid (dead feed → entry price) — no floor, no loss laundering.

# ── Panel / gateway ────────────────────────────────────────────────────────────
# BLITZKRIEG_PANEL_ADDR=127.0.0.1:51888   loopback only; expose via tunnel only
# BLITZKRIEG_ALLOWED_ORIGINS=             comma list; unset = same-origin only
# BLITZKRIEG_GITHUB_TOKEN=              read-only; read-only `public_repo` scope

# ── Market extensions (only when running that venue) ───────────────────────────
# POLYMARKET_PRIVATE_KEY=0x...   never commit; set via env, never here
# POLYMARKET_API_KEY=
# KALSHI_API_KEY=
# PREDICT_API_KEY=

# ── Test / dev only — leave unset in production ────────────────────────────────
# UIKIT_CORE_BIN=            target/release/blitzkrieg-core override
# UIKIT_CORE_CWD=            working dir for core subprocess
# UIKIT_CORE_EXTRA_ARGS=     extra CLI flags to core subprocess
# UIKIT_MANAGE=false         panel starts/stops the core process
# UIKIT_WEB_TRACE=
# HFT_ASSETS=BTC,ETH,SOL,XRP
# HFT_ROUND_SEC=900
# HFT_MIN_SHARES=10
# HFT_MAX_SHARES=10