# BlitzkriegBot — environment surface (the single trusted configuration source)
#
# Copy to `.env` and fill in what you need. NOTHING here is required to run in
# dry mode: every variable has a safe default, and the safest one (simulated
# orders, loopback-only panel) is what you get when the file is empty.
#
# Read this before trusting a name. There are four families:
#
#   BK_*            the kernel's own configuration. Precedence, highest first:
#                   command-line flag  >  BK_* env  >  user_layer/configs/*.toml
#                   >  built-in default. The kernel logs every value it resolved
#                   from above the default, naming its source, at startup.
#   BLITZKRIEG_*    panel / gateway / update-check / launcher-process settings.
#   <EXT>_*         market extensions — POLYMARKET_* / KALSHI_* / PREDICT_* /
#                   POLYSIM_* plus the shared CLOB_API_URL.
#   HFT_* / UIKIT_* the panel supervisor's spawn shape for the kernel (test /
#                   development only — see the last section).
#
# Every name in this file has a real reader in the code (docs/ENV_MIGRATION.md
# §3 lists the grep evidence per key). A name without a reader is a dead key:
# it gets deleted from here and from the live `.env` in the same change. The
# env single-source ruling (2026-10-23/24): engine parameters live HERE, not in
# user_layer/configs/default.toml — that file no longer carries any factory
# engine key. The 2026-10-28 ruling completes the single source: the account
# book, the evolution switches, the round-duration cell and the execution
# policy moved into `.env` too (the SINGLE-SOURCE CONFIG section below;
# scripts/migrate-config-to-env.sh retires the legacy files into
# data/config-backup-<timestamp>/).
#
# Anything credential-bearing belongs in this file ONLY. It is git-ignored; this
# example is not. Never commit a filled-in `.env`.
#
# Make the copy owner-only as soon as you create it:  `chmod 600 .env`. A fresh
# copy otherwise inherits the shell umask (0644) and every other account on the
# machine can read the wallet key, the API key and the panel password. The same
# rule applies to backups of it. When you inspect a `.env`, print key names only
# (`grep -o '^[A-Z_]*=' .env`) — never the values, in any log, issue or paste.

# =============================================================================
# SAFETY — read before changing anything below
# =============================================================================

# DRY_RUN=true (default) simulates every order. Setting it to `false` is the one
# switch that can move real money, and the project's hard rule is that Live stays
# off unless a human explicitly authorizes it with the wallet funded and present.
DRY_RUN=true

# =============================================================================
# KERNEL (BK_*) — trading parameters
# =============================================================================
#
# The env form is the operator's single trusted configuration surface
# (2026-10-23 ruling): `user_layer/configs/default.toml` no longer sets any
# factory key — it documents the extension surface only — so an unset variable
# here falls to the compiled-in default (assets BTC,ETH,SOL,XRP; round_sec 900;
# min_round_age 30; min_time_left 180), exactly the values the file used to
# carry. The round-duration UI card's persisted cell (data/runtime/config.json,
# mirrored into RUNTIME_ROUND_DURATION_SEC below) applies whenever no CLI flag
# or BK_* env var speaks; an explicit BK_ROUND_SEC suppresses the card
# (issue 499). Set variables for a one-off experiment, not as a second config
# file.

# Round length in seconds. 900 = 15m. Do NOT lower to 300 (5m) as a "tuning"
# tweak: the tradeable window is [min_round_age_sec, round_sec - min_time_left_sec]
# and both gates are absolute seconds, so 5m cuts the post-confirmation wait for
# a retrace from ~660s to ~30s. Measured: 5m took the engine from ~3 trades/hour
# to zero signals. `soak-health.sh` alarms on a running core whose argv says 300.
# BK_ROUND_SEC=900

# A round must be at least this old before an entry is allowed (lets the market
# settle after the rollover).
# BK_MIN_ROUND_AGE_SEC=30

# Never open an entry within this many seconds of expiry.
# BK_MIN_TIME_LEFT_SEC=180

# Comma-separated asset list, e.g. "BTC,ETH,SOL,XRP".
# BK_ASSETS=BTC,ETH,SOL,XRP

# Config file to read. Precedence: `--config` > BK_CONFIG > repo default.
# `BK_CONFIG=none` reads no file at all (same as `--no-config`).
# BK_CONFIG=user_layer/configs/default.toml

# Order sizing / bounds (the equity-relative path; 0 = off):
#   BK_SIZE_PCT                 per-entry budget, % of the account's cash equity
#                               (replaces the absolute size_usd path when > 0)
#   BK_MAX_ORDER_NOTIONAL_PCT   per-order notional cap, % of cash equity
#                               (an over-cap order is REJECTED, never truncated;
#                               closing intents are exempt)
#   BK_MAX_DAILY_LOSS           daily-loss breaker, absolute USD
#   BK_MAX_DAILY_LOSS_PCT       daily-loss breaker, % of the day's opening cash
#                               equity — the TIGHTER of the two applies
# BK_SIZE_PCT=
# BK_MAX_ORDER_NOTIONAL_PCT=
# BK_MAX_DAILY_LOSS=
# BK_MAX_DAILY_LOSS_PCT=

# Misc kernel knobs (each has a dedicated CLI flag that outranks it):
#   BK_NTP_HOST / BK_NTP_INTERVAL_SECS        time sync for the live venue
#   BK_MAX_ORDERBOOK_STALE_MS                 orderbook staleness budget
#   BK_STRATEGY_DIR / BK_LUA_STRATEGY_DIR     strategy package roots
# BK_NTP_HOST=
# BK_NTP_INTERVAL_SECS=
# BK_MAX_ORDERBOOK_STALE_MS=
# BK_STRATEGY_DIR=
# BK_LUA_STRATEGY_DIR=

# Shadow evolution (opt-in parameter search). Off unless enabled here or by
# `--shadow-evolution`; per-strategy isolation, gradient/size clamps and an audit
# trail are enforced by the kernel, not by these knobs. The two switches live in
# .env now (SHADOW_ENABLED / SHADOW_AUTO_EVOLVE in the SINGLE-SOURCE CONFIG
# section — the panel flip writes them back here); BK_SHADOW_EVOLUTION / BK_SE_*
# remain one-boot overrides on top.
# BK_SHADOW_EVOLUTION=false
# BK_SE_EVAL_WINDOW_SECS=
# BK_SE_COOLDOWN_SECS=
# BK_SE_MIN_SAMPLES=
# BK_SE_VARIANT_COUNT=
# BK_SE_MIN_WIN_RATE=
# BK_SE_MIN_PROFIT_FACTOR=
# BK_SE_MAX_GRADIENT=
# BK_SE_AUTO_EVOLVE=
# BK_SE_CYCLE_SECS=
# BK_SE_TTL_SECS=
# BK_SE_DEEP_DIMS=
# BK_SE_AUDIT_DIR=

# Update checks (docs/VERSIONING.md §7). The factory default is ZERO outbound
# connections (check off, auto off, no scheduler); data/update/state.json (the
# panel's system.update.configure) outranks these, and
# user_layer/configs/update.toml sits below them.
# BLITZKRIEG_UPDATE_CHECK=false
# BLITZKRIEG_UPDATE_AUTO=false
# BLITZKRIEG_UPDATE_INTERVAL_SECS=0

# =============================================================================
# SINGLE-SOURCE CONFIG (issue 751) — ACCOUNT_* / SHADOW_* / RUNTIME_* / POLICY_*
# =============================================================================
#
# The 2026-10-28 operator ruling retires the remaining config files: the
# account book, the evolution switches, the round-duration cell and the
# execution policy live HERE, and the kernel's own write faces upsert these
# keys (one line per key, everything else preserved byte-for-byte). Run
# `scripts/migrate-config-to-env.sh` once to move the legacy files into
# data/config-backup-<timestamp>/ and seed the keys below; edit only .env
# after that. Grammar authority, key by key — read before hand-editing:
#   core/blitzkrieg_core/src/account/config.rs        ACCOUNT_*
#   core/blitzkrieg_core/src/bin_support/boot.rs      SHADOW_*
#   core/blitzkrieg_core/src/ipc/runtime_config.rs    RUNTIME_*
#   core/blitzkrieg_core/src/execution_policy.rs      POLICY_*
#
# ── Account book ──
# ACCOUNT_LIST names every account id, comma-separated, book order. Every other
# account key is per-account: the id upper-cased with every non-alphanumeric
# folded to `_` (id `binance-main` → ACCOUNT_BINANCE_MAIN_*). Credential fields
# carry the NAMES of environment variables — never values (§9.4). STATUS spells
# active / read_only / frozen / suspended (absent = active). STRATEGIES /
# ROUNDS are comma lists; an absent key is the unrestricted spelling (an
# account with no strategies set runs nothing until enabled — assignment IS
# enablement, #552).
# ACCOUNT_LIST=default,paper
# ACCOUNT_DISPLAY=default
# ACCOUNT_DEFAULT_NAME=主账户
# ACCOUNT_DEFAULT_VENUE=polymarket
# ACCOUNT_DEFAULT_STATUS=active
# ACCOUNT_DEFAULT_TRADING_ENABLED=true
# ACCOUNT_DEFAULT_STRATEGIES=pair_discount_arb,spread_arb
# ACCOUNT_DEFAULT_ROUNDS=
# ACCOUNT_DEFAULT_API_KEY_ENV=POLYMARKET_API_KEY
# ACCOUNT_DEFAULT_SECRET_ENV=POLYMARKET_SECRET
# ACCOUNT_DEFAULT_PASSPHRASE_ENV=
# ACCOUNT_DEFAULT_PRIVATE_KEY_ENV=
# (every listed id repeats the same ten tails — paper, kalshi, …)
#
# Cross-venue arbitrage legs (the [cross_venue_arb] section; all-or-nothing —
# leg A needs venue+account, leg B likewise, and at least one pair):
# ACCOUNT_ARB_LEG_A_VENUE=
# ACCOUNT_ARB_LEG_A_ACCOUNT=
# ACCOUNT_ARB_LEG_B_VENUE=
# ACCOUNT_ARB_LEG_B_ACCOUNT=
# ACCOUNT_ARB_PAIRS=BTC-UP,BTC-DOWN
#
# ── Shadow evolution switches ──
# The two file-owned switches (shadow_evolution.toml's `enabled` / `auto_evolve`
# used to own them; the panel flip now writes back here). The window/threshold
# knobs keep their compiled defaults, overridable per boot with BK_SE_* above.
# SHADOW_ENABLED=false
# SHADOW_AUTO_EVOLVE=false
#
# ── Round duration (the round-duration card's persisted cell) ──
# Outranks the data/runtime/config.json cell; `--round-sec` / BK_ROUND_SEC
# outrank both (issue 499).
# RUNTIME_ROUND_DURATION_SEC=900
#
# ── Execution policy ──
# The POLICY_* family (issue 751); per-account keys carry the same suffix
# spelling as the account book. Precedence: per-account env > per-account toml >
# global env > global toml > code default. POLICY_RULES holds the rules as ONE
# JSON array string — the same objects the TOML [[*.rules]] tables spelled.
# POLICY_BUDGET_RATIO=0.10
# POLICY_MIN_BUDGET_USD=1
# POLICY_MAX_BUDGET_USD=50
# POLICY_MIN_EQUITY_USD=1
# POLICY_MAX_POSITIONS_PER_ASSET=1
# POLICY_RULES=[{"name":"global_backstop","enabled":true,"priority":100,"when":"open_positions >= 2","then":{"action":"skip"},"reason":"…"}]
# (per-account: POLICY_<ID>_BUDGET_RATIO / _MIN_BUDGET_USD / _MAX_BUDGET_USD /
#  _MIN_EQUITY_USD / _MAX_POSITIONS_PER_ASSET / _RULES)

# =============================================================================
# PANEL / GATEWAY (BLITZKRIEG_*)
# =============================================================================

# Panel login. In `--manage` mode (the gateway starts and supervises the kernel)
# BOTH of these are mandatory: configure neither and the gateway refuses to start
# (exit 2) rather than inventing a password. Configure only one and it is the
# same as configured none — guessing the operator's intent is exactly how a panel
# ends up open. The process never prints a credential it chose itself.
# BLITZKRIEG_PANEL_USER=
# BLITZKRIEG_PANEL_PASSWORD=

# Listen address for the panel (`--addr` outranks it). The default is loopback
# only; 0.0.0.0:51888 exposes it to the LAN — put the panel behind a reverse
# proxy and set BLITZKRIEG_ALLOWED_ORIGINS (below) when you do.
# BLITZKRIEG_PANEL_ADDR=0.0.0.0:51888

# Comma-separated trusted origins for CSRF/Origin checking when the panel sits
# behind a reverse proxy (e.g. "https://panel.example.com"). Unset = same-origin
# only.
# BLITZKRIEG_ALLOWED_ORIGINS=

# Crash/restart alert webhook the gateway supervisor posts to when the core
# exceeds its restart budget (a channel URL; values never logged).
# BLITZKRIEG_ALERT_NOTIFY=

# GitHub API token for the update check (header-only; fixes anonymous 60/h
# quota 403). Read-only `public_repo` scope is plenty.
# BLITZKRIEG_GITHUB_TOKEN=

# Launcher-process escapes (the shell scripts behind `blitzkrieg upgrade` /
# `blitzkrieg backup` / the shim installer). Defaults are sane; override only
# with intent.
#   BLITZKRIEG_UPGRADE_SOURCE     git ref to upgrade from   (default ceer/main)
#   BLITZKRIEG_UPGRADE_DEADLINE   start-identity deadline s (default 120)
#   BLITZKRIEG_BACKUP_DIR         backup target root
#   BLITZKRIEG_SHIM_DIR           where the shim is installed
# BLITZKRIEG_UPGRADE_SOURCE=ceer/main
# BLITZKRIEG_UPGRADE_DEADLINE=120
# BLITZKRIEG_BACKUP_DIR=
# BLITZKRIEG_SHIM_DIR=

# =============================================================================
# MARKET EXTENSION — Polymarket
# =============================================================================

# Live credentials. Required only when the extension runs in live mode; with
# them absent the venue bridge stays disabled and logs that fact. The private key
# signs orders — treat it as the wallet itself. The CLOB L2 API credentials are
# DERIVED from the private key at connect (`create_or_derive_api_key`) — there
# are NO POLYMARKET_API_KEY/SECRET/PASSPHRASE variables; a `.env` line carrying
# one is a Node-era relic and nothing reads it.
# POLYMARKET_PRIVATE_KEY=0x...
# POLYMARKET_FUNDER_ADDRESS=

# CLOB REST base, shared by the feed and the order path.
# CLOB_API_URL=https://clob.polymarket.com

# Orderbook poll interval, ms (default 1000; clamped to 250..60000).
#
# The feed reads the book from REST `POST /books` rather than the venue's
# WebSocket market channel: that channel has no message filter and cost 33-40
# GB/day per socket, while the batch endpoint costs ~1.75 GB/day at 1s. Raising
# this past the engine's 8s orderbook-staleness budget leaves the book unpricable
# between polls, and the core logs a warning when it does.
# POLYMARKET_POLL_MS=1000

# WebSocket URL used by the venue bridge (defaults to the public endpoint).
# POLYMARKET_WS_URL=

# Order-source fingerprint (#694). Two independent knobs, both optional:
#
# The kernel's own API-key derivation nonce. The venue derives its L2 key from
# (address, nonce); UNSET and 0 both keep the historical nonce-0 key — the one
# the web session derives from the same private key — so fills stay
# indistinguishable, exactly as before. Set 1 (or any other value) to derive a
# KERNEL-ONLY key: every venue fill then names the kernel's key id in its
# `owner` field, separating "kernel / same-key web session / stranger with the
# private key" in the trade history. Both keys coexist (`GET /auth/api-keys`).
# A malformed value FAILS the venue spawn rather than falling back to 0.
# POLYMARKET_API_KEY_NONCE=
#
# The 20-bit deployment watermark embedded in every order salt (high bits; the
# low 33 stay per-order random; readable back via authenticated
# `GET /data/order/{id}`). UNSET = generated once from machine identity +
# install moment and persisted at data/runtime/deploy-fingerprint, so restarts
# keep the same value and a fresh install on the same machine gets a new one.
# Set a number (decimal/0x-hex, masked to 20 bits) or any name string (hashed)
# to pin it explicitly — e.g. when two deployments must never share a mark.
# BLITZKRIEG_DEPLOY_FINGERPRINT=

# On-chain redemption subsystem (POLY collateral back to the funder wallet).
# Opt-out switch for an operator on a shared RPC or one who redeems by hand;
# POLYGON_RPC_URL has NO default — a mainnet transaction is never sent through
# a public endpoint unprompted.
# POLYMARKET_REDEEM_ENABLED=false
# POLYGON_RPC_URL=

# Data-directory guard escape (`--allow-shared-data`'s env form; the same
# allow-list applies). Unset = the data directories stay guarded.
# BLITZKRIEG_ALLOW_SHARED_DATA=false

# =============================================================================
# MARKET EXTENSIONS — kalshi / predictfun / polysimulator (executors)
# =============================================================================
#
# Required only when that plugin's executor must trade; with them absent the
# executor stays inert and the data plane (feed + discovery) still works. The
# plugins page's API-credentials card writes the SAME names into
# data/runtime/config.json — a real environment variable (this file) always
# outranks that cell.
#
# Kalshi: Key ID from your account's API page + the RSA private key file you
# downloaded when creating it (PEM, full text including header/footer lines).
# Use the demo site's key for demo trading.
# KALSHI_API_KEY_ID=
# KALSHI_RSA_PRIVATE_KEY=
# KALSHI_API_URL=
# KALSHI_POLL_MS=
# KALSHI_NO_PROXY=

# Predict.fun: account API key + the wallet private key that signs orders.
# PREDICT_API_KEY=
# PREDICT_PRIVATE_KEY=
# PREDICT_JWT_TOKEN=
# PREDICT_API_URL=
# PREDICT_POLL_MS=
# PREDICT_NO_PROXY=

# PolySimulator (third-party simulated venue): the key its own process issued.
# Since the parasitic rebuild (#638) this venue has NO feed of its own — market
# data and rounds come from the polymarket plugin's stream (mirror_of), so
# there is no POLYSIM_POLL_MS: the old key lost its only reader when the
# plugin's feed was deleted and is gone from here (a line in your `.env` is
# inert; delete it).
# POLYSIM_API_KEY=
# POLYSIM_API_URL=
# POLYSIM_NO_PROXY=

# Execution-policy sizing overrides — the pre-751 bare aliases, kept read-only.
# The single-source family is the POLICY_* set in the SINGLE-SOURCE CONFIG
# section above (same per-account suffix spelling: the account id upper-cased,
# non-alphanumeric folded to `_`). Precedence: account env > account toml
# section > global env > [defaults] > code default.
# BUDGET_RATIO=
# MAX_BUDGET_USD=

# =============================================================================
# TEST / DEVELOPMENT ONLY — not for production runs
# =============================================================================
#
# UIKIT_CORE_BIN / UIKIT_CORE_CWD / UIKIT_CORE_EXTRA_ARGS let a gate point the
# panel at a throwaway kernel binary, working directory and argument set.
# UIKIT_CORE_EXTRA_ARGS is appended verbatim to the spawn argv.
# UIKIT_MANAGE forces the gateway/panel manage flag on.
# UIKIT_WEB_TRACE enables request tracing in the gateway.
#
# HFT_ASSETS / HFT_ROUND_SEC / HFT_MIN_SHARES / HFT_MAX_SHARES are the shape the
# panel supervisor uses when it spawns a kernel for you; they are its own knobs
# and take precedence over the kernel's BK_* only because they become CLI args.
# HFT_ROUND_SEC in particular suppresses the UI card's persisted round-length
# cell (issue 499) — leave it unset unless you mean to pin the round length.
#
# HFT_CORE is GONE: it routed the deleted Node engine (removed in 62b16c8) and
# nothing reads it since — a line in your `.env` is inert.
#
# Leave all of these unset outside a controlled experiment.
# UIKIT_CORE_BIN=target/release/blitzkrieg-core
# UIKIT_CORE_CWD=
# UIKIT_CORE_EXTRA_ARGS=
# UIKIT_MANAGE=false
# UIKIT_WEB_TRACE=
# HFT_ASSETS=BTC,ETH,SOL,XRP
# HFT_ROUND_SEC=900
# HFT_MIN_SHARES=10
# HFT_MAX_SHARES=10
#
# The Tauri desktop shell's dev flow (`cargo tauri dev`) and the strategy
# loader's test escapes — none of these are read by the production launcher:
# BLITZKRIEG_CORE_BIN      chain-test binary override (src-tauri tests)
# BLITZKRIEG_PANEL_URL     point the desktop shell at a running panel
# BLITZKRIEG_STRATEGY_MANIFEST / BLITZKRIEG_STRATEGY_ALLOW_DIRS
#                          strategy-loader manifest root / shared-directory
#                          allow-list (loader.rs; test isolation only)
# BLITZKRIEG_CORE_BIN=
# BLITZKRIEG_PANEL_URL=
# BLITZKRIEG_STRATEGY_MANIFEST=
# BLITZKRIEG_STRATEGY_ALLOW_DIRS=
#
# UIKIT_CORE_EXTRA_ARGS is also how an operator reaches a kernel flag that has
# no dedicated env key — it is appended verbatim to the spawned core's argv
# (whitespace-split, quotes respected). E.g. disarming the maker→taker entry
# escalation entirely:
# UIKIT_CORE_EXTRA_ARGS=--entry-maker-timeout-ms -1
