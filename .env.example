# BlitzkriegBot — environment surface (single source of truth)
#
# Copy to `.env` and fill in what you need. Nothing required in dry mode.
# Never commit a filled-in `.env`. chmod 600 after creating.
#
# Every key has a real reader; an empty key = disabled/default.
#
# 操作者裁决 2026-11-14（issue #1199 第六轮）：`.env` 对内核是只读的——
# 账户、策略、轮次、风控、凭证、开关全部持久化在 SQLite
# （data/blitzkrieg.sqlite），内核不再写入本文件的任何键。本文件只在
# 安装/生成期由安装器创建（并生成 BLITZKRIEG_DB_KEY）。

# ── Only switch you ever flip ────────────────────────────────────────────────
# DRY_RUN=true  simulate every order, never touch venue cash
# DRY_RUN=false live orders — wallet-funded account + operator approval required
DRY_RUN=true

# ── Panel credentials (required once, read from here) ──────────────────────────
# Generated automatically on first boot by the installer (`blitzkrieg run`
# when .env does not exist). Generate by hand: openssl rand -hex 16
BLITZKRIEG_PANEL_USER=
BLITZKRIEG_PANEL_PASSWORD=

# ── SQLite master key (issue #1189) ────────────────────────────────────────────
# Encrypts account credentials at rest in data/blitzkrieg.sqlite (AES-256-GCM,
# one random nonce per record: nonce + ciphertext + tag). Auto-generated by
# the installer on first boot; leave it as generated. openssl rand -base64 32
# is the hand spelling (exactly 32 raw bytes, base64-encoded).
# Missing or wrong key = decryption REFUSED with a clear error; there is no
# silent plaintext fallback, ever. Never commit a filled-in value; BACK IT UP
# — losing this key loses every credential stored in the database.
BLITZKRIEG_DB_KEY=

# ── Kernel (BK_*) — CLI flag > this env > compiled default ─────────────────────
# Nothing is required here; defaults are safe. Set only what you intend to change.

# Order budget: percentage of account cash equity per entry (0 = off)
# BK_SIZE_PCT=

# Daily-loss breaker: absolute USD (tighter of the two applies)
# BK_MAX_DAILY_LOSS=
# BK_MAX_DAILY_LOSS_PCT=   % of opening cash equity

# Per-order notional cap, % of cash equity (over-cap rejected, never truncated)
# BK_MAX_ORDER_NOTIONAL_PCT=

# BK_SETTLEMENT_FALLBACK_FLOOR_PCT is removed: unverifiable-expiry closes book
# at the raw last mid (dead feed → entry price) — no floor, no loss laundering.

# ── Panel / gateway ────────────────────────────────────────────────────────────
# BLITZKRIEG_PANEL_ADDR=127.0.0.1:51888   loopback only; expose via tunnel only
# BLITZKRIEG_ALLOWED_ORIGINS=             comma list; unset = same-origin only
# BLITZKRIEG_GITHUB_TOKEN=              read-only; read-only `public_repo` scope

# ── Market credentials — values stay here as fallback only (issue #1189) ──────
# Account rows in SQLite store variable NAMES, not values; credential values
# stay in this file (or the process environment) as the fallback source. On
# first use they are encrypted into the database (AES-256-GCM, master key
# BLITZKRIEG_DB_KEY). A database row without a value falls back to the .env
# value; a missing master key refuses decryption — never plaintext.
# Never commit a filled-in .env.
#
# POLYMARKET_PRIVATE_KEY=0x...   L2 credentials are derived from this key
# KALSHI_API_KEY_ID=             exchange API key id
# KALSHI_RSA_PRIVATE_KEY=        PEM-encoded RSA private key (never commit)
# PREDICT_API_KEY=

# ── Test / dev only — leave unset in production ────────────────────────────────
# UIKIT_CORE_BIN=            target/release/blitzkrieg-core override
# UIKIT_CORE_CWD=            working dir for core subprocess
# UIKIT_CORE_EXTRA_ARGS=     extra CLI flags to core subprocess
# UIKIT_MANAGE=false         panel starts/stops the core process
# UIKIT_WEB_TRACE=
# HFT_ASSETS=BTC,ETH,SOL,XRP
# HFT_ROUND_SEC=900
# HFT_MIN_SHARES=10
# HFT_MAX_SHARES=10