# BlitzkriegBot — environment surface
#
# Copy to `.env` and fill in what you need. NOTHING here is required to run in
# dry mode: every variable has a safe default, and the safest one (simulated
# orders, loopback-only panel) is what you get when the file is empty.
#
# Read this before trusting a name. There are three distinct families, and only
# the kernel reads the first two:
#
#   BK_*            the kernel's own configuration. Precedence, highest first:
#                   command-line flag  >  BK_* env  >  user_layer/configs/*.toml
#                   >  built-in default. The kernel logs every value it resolved
#                   from above the default, naming its source, at startup.
#   BLITZKRIEG_*    panel / gateway process settings.
#   POLYMARKET_*/CLOB_API_URL   market extension (feed + order path).
#
# The retired Node product's variables — messaging channels (Telegram, Discord,
# Slack, Matrix, …), LLM keys (ANTHROPIC_/OPENAI_/TOGETHER_), MCP tool policy,
# Bittensor mining, the compute marketplace — are gone with it (D-24). They are
# listed in git history, not here: a name in this file is a promise something
# reads it, and nothing does.
#
# Anything credential-bearing belongs in this file ONLY. It is git-ignored; this
# example is not. Never commit a filled-in `.env`.

# =============================================================================
# SAFETY — read before changing anything below
# =============================================================================

# DRY_RUN=true (default) simulates every order. Setting it to `false` is the one
# switch that can move real money, and the project's hard rule is that Live stays
# off unless a human explicitly authorizes it with the wallet funded and present.
DRY_RUN=true

# =============================================================================
# KERNEL (BK_*) — trading parameters
# =============================================================================
#
# These mirror `user_layer/configs/default.toml`; the env form wins over the
# file. Leave them unset and the shipped default.toml governs, which is the
# intended steady state. Set them for a one-off experiment, not as a second
# config file.

# Round length in seconds. 900 = 15m. Do NOT lower to 300 (5m) as a "tuning"
# tweak: the tradeable window is [min_round_age_sec, round_sec - min_time_left_sec]
# and both gates are absolute seconds, so 5m cuts the post-confirmation wait for
# a retrace from ~660s to ~30s. Measured: 5m took the engine from ~3 trades/hour
# to zero signals. `soak-health.sh` alarms on a running core whose argv says 300.
# BK_ROUND_SEC=900

# A round must be at least this old before an entry is allowed (lets the market
# settle after the rollover).
# BK_MIN_ROUND_AGE_SEC=30

# Never open an entry within this many seconds of expiry.
# BK_MIN_TIME_LEFT_SEC=180

# Comma-separated asset list, e.g. "BTC,ETH,SOL,XRP".
# BK_ASSETS=BTC,ETH,SOL,XRP

# Config file to read. Precedence: `--config` > BK_CONFIG > repo default.
# `BK_CONFIG=none` reads no file at all (same as `--no-config`).
# BK_CONFIG=user_layer/configs/default.toml

# Shadow evolution (opt-in parameter search). Off unless enabled here or by
# `--shadow-evolution`; per-strategy isolation, gradient/size clamps and an audit
# trail are enforced by the kernel, not by these knobs.
# BK_SHADOW_EVOLUTION=false
# BK_SE_EVAL_WINDOW_SECS=
# BK_SE_COOLDOWN_SECS=
# BK_SE_MIN_SAMPLES=
# BK_SE_VARIANT_COUNT=
# BK_SE_MIN_WIN_RATE=
# BK_SE_MIN_PROFIT_FACTOR=
# BK_SE_MAX_GRADIENT=
# BK_SE_AUDIT_DIR=

# =============================================================================
# PANEL / GATEWAY (BLITZKRIEG_*)
# =============================================================================

# Panel login. In `--manage` mode (the gateway starts and supervises the kernel)
# BOTH of these are mandatory: configure neither and the gateway refuses to start
# (exit 2) rather than inventing a password. Configure only one and it is the
# same as configured none — guessing the operator's intent is exactly how a panel
# ends up open. The process never prints a credential it chose itself.
# BLITZKRIEG_PANEL_USER=
# BLITZKRIEG_PANEL_PASSWORD=

# =============================================================================
# MARKET EXTENSION — Polymarket
# =============================================================================

# Live credentials. Required only when the extension runs in live mode; with
# them absent the venue bridge stays disabled and logs that fact. The private key
# signs orders — treat it as the wallet itself.
# POLYMARKET_PRIVATE_KEY=0x...
# POLYMARKET_FUNDER_ADDRESS=

# CLOB REST base, shared by the feed and the order path.
# CLOB_API_URL=https://clob.polymarket.com

# Orderbook poll interval, ms (default 1000; clamped to 250..60000).
#
# The feed reads the book from REST `POST /books` rather than the venue's
# WebSocket market channel: that channel has no message filter and cost 33-40
# GB/day per socket, while the batch endpoint costs ~1.75 GB/day at 1s. Raising
# this past the engine's 8s orderbook-staleness budget leaves the book unpricable
# between polls, and the core logs a warning when it does.
# POLYMARKET_POLL_MS=1000

# WebSocket URL used by the venue bridge (defaults to the public endpoint).
# POLYMARKET_WS_URL=

# =============================================================================
# TEST / DEVELOPMENT ONLY — not for production runs
# =============================================================================
#
# UIKIT_CORE_BIN / UIKIT_CORE_CWD / UIKIT_CORE_EXTRA_ARGS let a gate point the
# panel at a throwaway kernel binary, working directory and argument set.
# UIKIT_CORE_EXTRA_ARGS is appended verbatim to the spawn argv.
# UIKIT_MANAGE forces the gateway/panel manage flag on.
# UIKIT_WEB_TRACE enables request tracing in the gateway.
#
# HFT_ASSETS / HFT_ROUND_SEC / HFT_MIN_SHARES / HFT_MAX_SHARES are the shape the
# panel supervisor uses when it spawns a kernel for you; they are its own knobs
# and take precedence over the kernel's BK_* only because they become CLI args.
#
# Leave all of these unset outside a controlled experiment.
# UIKIT_CORE_BIN=target/release/blitzkrieg-core
# UIKIT_CORE_CWD=
# UIKIT_CORE_EXTRA_ARGS=
# UIKIT_MANAGE=false
# UIKIT_WEB_TRACE=
# HFT_ASSETS=BTC,ETH,SOL,XRP
# HFT_ROUND_SEC=900
# HFT_MIN_SHARES=10
# HFT_MAX_SHARES=10
