{
  "name": "blitzkrieg-bot",
  "version": "0.1.0",
  "description": "BlitzkriegBot — high-frequency trading core for prediction markets (Polymarket, Kalshi). Rust engine + Rust panel; this Node layer is only the IPC client and verification harness for the core.",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "core:build": "cargo build --release --manifest-path core/blitzkrieg_core/Cargo.toml",
    "core:test": "cargo test --lib --manifest-path core/blitzkrieg_core/Cargo.toml",
    "core:shutdown-check": "node scripts/shutdown-cleanliness-check.mjs",
    "core:parent-monitor-check": "node scripts/parent-monitor-check.mjs",
    "core:readonly-check": "node scripts/readonly-egress-check.mjs",
    "core:crash-recovery-check": "node scripts/crash-recovery-check.mjs",
    "core:parity": "npm run build && node scripts/core-parity.mjs",
    "account:test": "cargo test --manifest-path core/blitzkrieg_core/Cargo.toml --lib --features account-precision account_precision",
    "account:parity": "npm run core:build && npm run build && node scripts/account-parity.mjs",
    "account:drift-check": "node scripts/account-drift-check.mjs",
    "size:check": "node scripts/binary-size-check.mjs",
    "size:report": "node scripts/binary-size-check.mjs --verbose",
    "package:check": "node scripts/package-release.mjs",
    "package:release": "node scripts/package-release.mjs --keep --out target/release-bundle",
    "core:observe": "npm run build && node scripts/dry-observe.mjs",
    "core:strategy-limit": "node scripts/strategy-limit-check.mjs",
    "core:strategy-gate": "node scripts/strategy-gate-check.mjs",
    "core:strategy-evolve": "node scripts/strategy-evolution-check.mjs",
    "core:trend-follow": "node scripts/trend-follow-check.mjs",
    "core:mean-reversion": "node scripts/mean-reversion-check.mjs",
    "ui:plugin-gateway": "node scripts/ui-plugin-check.mjs",
    "ui:plugin-panel-pty": "python3 scripts/ui-panel-plugin-pty-check.py",
    "ui:webapp": "node scripts/webapp-check.mjs",
    "test": "node --test --import tsx --import ./tests/helpers/test-setup.ts tests/**/*.test.ts",
    "ci": "npm run typecheck && npm run test && npm run build",
    "scale:plugins": "node scripts/scale-plugins-check.mjs",
    "scale:feed": "node scripts/feed-scale-check.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceer-quant/BlitzkriegBot"
  },
  "dependencies": {
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1",
    "ws": "^8.21.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  }
}
