{
  "name": "blitzkrieg-panel-webui",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "vue-tsc --noEmit",
    "check:theme": "node --experimental-strip-types scripts/theme-follow-system.check.mjs",
    "check:balance": "node --experimental-strip-types scripts/balance-accounting.check.mjs",
    "check:lifecycle": "node --experimental-strip-types scripts/lifecycle-control.check.mjs",
    "check:rejections": "node --experimental-strip-types scripts/refusal-attribution.check.mjs",
    "check:feed": "node --experimental-strip-types scripts/feed-liveness.check.mjs",
    "check:session": "node --experimental-strip-types scripts/session-recovery.check.mjs",
    "check:history": "node --experimental-strip-types scripts/history-tab.check.mjs",
    "check:round": "node --experimental-strip-types scripts/round-header.check.mjs",
    "check:expand": "node --experimental-strip-types scripts/expand-reflow.check.mjs",
    "check:source": "node --experimental-strip-types scripts/strategy-source.check.mjs",
    "check:design": "node --experimental-strip-types scripts/design-language.check.mjs",
    "check:first-run": "node --experimental-strip-types scripts/first-run.check.mjs",
    "check:separation": "node --experimental-strip-types scripts/page-separation.check.mjs",
    "check:parity": "node --experimental-strip-types scripts/tui-parity.check.mjs",
    "check:safety": "node --experimental-strip-types scripts/safety-banners.check.mjs",
    "check:all": "npm run check && npm run check:theme && npm run check:balance && npm run check:lifecycle && npm run check:rejections && npm run check:safety && npm run check:feed && npm run check:session && npm run check:history && npm run check:round && npm run check:expand && npm run check:source && npm run check:design && npm run check:first-run && npm run check:separation && npm run check:parity"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  },
  "private": true
}
