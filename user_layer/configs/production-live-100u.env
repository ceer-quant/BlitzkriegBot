# Opt-in 100 USDC live profile (issue #870).
#
# Sourcing this file is the opt-in. It is the only shipped env that sets
# DRY_RUN=false. `.env.example` and production-72h.env stay DRY_RUN=true.
# Do not source it, and do not start a process with it, until
# `node scripts/live-100u-preflight.mjs` has exited 0. That preflight is
# read-only: it checks collateral balance, USDC allowances, and on-chain
# fills/positions, and it does not read the private key.
#
#   node scripts/live-100u-preflight.mjs
#
# The bot already runs on the operator's machine. This file is configuration
# for that process. It does not start one.
#
# No strategy is enabled. The allowlist stays empty until the soak gate
# records a GO.

DRY_RUN=false
BK_CONFIG=user_layer/configs/production-live-100u.toml
BK_LIVE_BANKROLL_USD=100
BK_MAX_DAILY_LOSS=5
BK_MAX_DAILY_LOSS_PCT=5
BK_SIZE_PCT=1
BK_MAX_ORDER_NOTIONAL_PCT=2
BK_LIVE_MAX_ORDER_NOTIONAL=2
BK_LIVE_MIN_SHARES=1
BK_LIVE_MAX_SHARES=2
BK_MAX_ORDERBOOK_STALE_MS=3500
