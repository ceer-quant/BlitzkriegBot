# Opt-in 100 USDC live profile (issue #870).
#
# This is the only shipped env that sets DRY_RUN=false. `.env.example` and
# production-72h.env stay DRY_RUN=true. Do not source this file by hand.
# scripts/go-live-100u.sh applies it to the child process only after
# scripts/soak-72h-check.mjs accepts the dry-run trade log.

DRY_RUN=false
BK_CONFIG=user_layer/configs/production-live-100u.toml
BK_LIVE_BANKROLL_USD=100
BK_MAX_DAILY_LOSS=5
BK_MAX_DAILY_LOSS_PCT=5
BK_SIZE_PCT=1
BK_MAX_ORDER_NOTIONAL_PCT=2
BK_LIVE_MAX_ORDER_NOTIONAL=2
BK_LIVE_MIN_SHARES=1
BK_LIVE_MAX_SHARES=2
BK_MAX_ORDERBOOK_STALE_MS=3500
