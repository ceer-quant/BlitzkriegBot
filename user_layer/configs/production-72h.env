# 72-hour dry profile. Source it; never set DRY_RUN=false from this file.
# Real-money go-live stays an operator decision (issue #868).
#
#   set -a && source user_layer/configs/production-72h.env && set +a
#   blitzkrieg-core --mode dry --no-strategy-state ...
#
# See scripts/soak-72h.sh for the preflight and the exact argv.

DRY_RUN=true
BK_MAX_DAILY_LOSS_PCT=10
BK_MAX_ORDER_NOTIONAL_PCT=20
BK_MAX_ORDERBOOK_STALE_MS=3500

# Issue #967: the nine systemic bounds used to arrive from
# production-72h.toml. That TOML layer is retired — env is the only input —
# so they are spelled here. `BK_CONFIG` is gone too: a boot that still carries
# the flag refuses it, and a `.env` that still carries the key is inert.
BK_RISK_MAX_SINGLE_LOSS_USD=0.50
BK_RISK_MAX_DAILY_DRAWDOWN_USD=5
BK_RISK_MAX_POSITION_SIZE=5
BK_RISK_MAX_CONSECUTIVE_LOSSES=4
BK_RISK_COOLDOWN_MINUTES=30
