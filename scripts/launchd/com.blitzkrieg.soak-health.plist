<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.blitzkrieg.soak-health — zero-token soak health check via launchd.

  Runs scripts/soak-health.sh every 30 minutes. Because the script is pure shell
  (no LLM), this costs ZERO API tokens and can safely run at any hour — there is
  no reason to gate it to off-peak. Only if it fails (exit 1) should an agent be
  involved; see docs/COST_OPTIMIZATION.md.

  Install:
    cp scripts/launchd/com.blitzkrieg.soak-health.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.blitzkrieg.soak-health.plist
  Remove:
    launchctl unload -w ~/Library/LaunchAgents/com.blitzkrieg.soak-health.plist
    rm ~/Library/LaunchAgents/com.blitzkrieg.soak-health.plist

  NOTE: the repo path contains a space. It is split into separate <string>
  array elements so launchd never needs quoting.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.blitzkrieg.soak-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Volumes/Hard Disk/BlitzkriegBot/scripts/soak-health.sh</string>
    <string>--quiet</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Volumes/Hard Disk/BlitzkriegBot</string>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Volumes/Hard Disk/BlitzkriegBot/data/soak/health.out</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/Hard Disk/BlitzkriegBot/data/soak/health.err</string>
</dict>
</plist>
